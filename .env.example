# ============ IP-SAKTI SAHAYAK (SIH 26045) ============
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/ip_sakti_sahayak

# ---- Auth ----
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SECRET=replace-with-at-least-32-random-characters

# ---- LLM provider abstraction ----
# hybrid | trained | cloud | gemini | ollama | lmstudio | none
# hybrid is trained Qwen first, then NVIDIA, Gemini and Ollama, with a
# deterministic-only fallback when no provider is available.
LLM_PROVIDER=hybrid

# Cloud (OpenAI-compatible; default NVIDIA NIM)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_REQUEST_TIMEOUT_MS=60000

# Fine-tuned Qwen3-8B served by Ollama (primary when enabled)
TRAINED_MODEL_ENABLED=false
TRAINED_MODEL_BASE_URL=http://localhost:11434/v1
TRAINED_MODEL_API_KEY=ollama
TRAINED_MODEL=ip-sakti-qwen3-8b
# Absolute path to deployment-manifest.json with deploymentGate.passed=true.
# The trained provider stays disabled until this gate is verified.
TRAINED_MODEL_MANIFEST=

# Gemini (OpenAI-compatible endpoint; API key stays server-side)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_REASONING_EFFORT=low
GEMINI_REQUEST_TIMEOUT_MS=60000

# Preferred local Ollama model in the default hybrid chain
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:8b
# Used automatically when the preferred model is not installed or reachable
OLLAMA_FALLBACK_MODEL=qwen3:4b
# Ollama runtime tuning: keep the model warm, bound context/output for latency,
# and disable Qwen3 chain-of-thought for concise grounded answers.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1600
OLLAMA_THINK=false

# Optional local LM Studio (OpenAI-compatible endpoints on localhost:1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=

# Task-level model routing (optional; falls back to provider model)
MAIN_REASONING_MODEL=
CLASSIFICATION_MODEL=
EMBEDDING_MODEL=

# Structured-output strategy for local models: auto | json_mode | off
LLM_STRUCTURED_OUTPUT=auto
LLM_TEMPERATURE=0.1

# ---- Retrieval / vector index (Atlas $vectorSearch optional) ----
VECTOR_INDEX_NAME=knowledge_vector_index
VECTOR_DIMENSIONS=2048
RETRIEVAL_MIN_SCORE=0.68

# ---- Security ----
ENCRYPTION_KEY=base64-encoded-32-byte-key
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info

# ============ PRODUCTION CHECKLIST ============
# Before deploying to production, ensure:
#   1. NODE_ENV=production
#   2. All *_SECRET values are freshly generated, ≥32 random characters
#      (e.g. `openssl rand -base64 48`)
#   3. MONGODB_URI points to a managed instance (Atlas or self-hosted with TLS)
#      — MongoDB replica set is required for the in-app transactions
#   4. APP_ORIGIN matches the deployed dashboard URL exactly (CORS gate)
#   5. LLM_PROVIDER is 'hybrid', 'trained', 'cloud', 'gemini', 'ollama', 'lmstudio' or 'none'
#   6. EMBEDDING_MODEL is configured (so vector retrieval works); otherwise
#      the system falls back to BM25 lexical retrieval automatically
#   7. Helmet HSTS activates only in production (see src/app.js)
#   8. Rate limit defaults are appropriate for expected traffic; see app.js
#   9. After first boot, run `npm run seed:legal` exactly once to populate
#      the jurisdiction-tagged legal corpus (re-running is idempotent — wipes + reseeds)
#  10. For the evaluation workspace, run `npm run seed:demo` to create the four
#      non-production role demo accounts and their sample workspaces.
#  11. The dashboard build (`npm --prefix dashboard run build`) is served by
#      a static host (nginx, S3+CloudFront, etc.); VITE_API_URL must point
#      at the production backend origin.
